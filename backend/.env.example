# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/appsecurity?schema=public"

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:3000

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@appsecurity.com

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Push Notifications (FCM / Firebase Cloud Messaging)
# Opción A: un Service Account JSON completo (base64 o JSON plano)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Opción B: campos individuales del Service Account
FIREBASE_PROJECT_ID=my-appsecurity-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@my-appsecurity-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Config pública para los clientes web (GET /config/messaging)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MSG_SENDER_ID=""
FIREBASE_APP_ID=""
# VAPID public key requerida para Web Push
FIREBASE_VAPID_KEY=""